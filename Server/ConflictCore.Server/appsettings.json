{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MatchServer": {
    "Port": 7777,
    "TickRate": 15,
    "MaxCatchUpTicks": 5,
    "DataDirectory": "Data",
    "MinimumClientVersion": "0.1.0",
    "ReconnectGraceSeconds": 90
  }
}
