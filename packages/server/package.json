{
  "name": "@conflict/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --packages=external --alias:@conflict/shared=../shared/src/index.ts",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@conflict/shared": "0.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12"
  }
}
